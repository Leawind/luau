{
  "includes": ["**/*"],
  "excludes": [
    "**/native/luau/**",
    "**/build/**",
    "**/.gradle/**",
    "**/node_modules/**",
    "**/pack.mcmeta"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.26.0.wasm",
    "npm:@dprint/markdown@0.29.0",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ],
  "json": {
    "indentWidth": 2,
    "lineWidth": 120
  },
  "markdown": {
    "lineWidth": 120,
    "textWrap": "maintain"
  },
  "toml": {}
}
